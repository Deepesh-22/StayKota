# Optional: enables custom StayKota hostel/campus pins on the live Google map.
# Without a key, the full-city Google embedded map still appears.
# Browser keys are public: restrict this key by website referrer AND API in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=
# Set your own Google map ID for production Advanced Markers.
# Development falls back to Google's documented DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
